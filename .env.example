# PostgreSQL connection string (Render injects this automatically via render.yaml)
DATABASE_URL="postgresql://user:password@host:5432/ai_governance?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/ai_governance?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Your Render public URL, e.g. https://ai-governance-dashboard.onrender.com
NEXTAUTH_URL="https://your-app.onrender.com"
APP_URL="https://your-app.onrender.com"

# Password for seeded demo accounts (super@platform.com, admin@*, viewer@*)
SEED_PASSWORD="changeme"

# ── HumaniCore governance engine ──────────────────────────────────────────
# Required for the live screens: Compliance, Bias & Fairness, Hiring AI and the
# Audit Report. Without these they render an explicit "unavailable" state — they
# never fall back to seeded data.
#
# SERVER-SIDE ONLY. Never prefix the key with NEXT_PUBLIC_; it is used solely in
# route handlers so it does not reach the browser.
ENGINE_BASE_URL="https://your-engine-host.example"
ENGINE_API_KEY="your-engine-api-key"

# Optional — deployment footprint Compliance resolves requirements against.
# Defaults to US-CA,US-NY,US-TX,US-FL with no countries.
# ENGINE_FOOTPRINT_US_STATES="US-CA,US-NY,US-TX,US-FL"
# ENGINE_FOOTPRINT_COUNTRIES="DE,FR"

# Show seeded demonstration screens (AI Models, Performance, Pay Equity, Audit
# Logs, Governance Cases) and the seeded sections of Compliance and Hiring.
# Default OFF: those screens are hidden from the nav AND blocked by middleware,
# so seeded figures can never be mistaken for audit findings. Set to "true" for
# a walkthrough; they then render with an explicit demo-data banner.
NEXT_PUBLIC_SHOW_DEMO_DATA="false"
