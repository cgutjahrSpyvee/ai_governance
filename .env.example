# PostgreSQL connection string (Render injects this automatically via render.yaml)
DATABASE_URL="postgresql://user:password@host:5432/ai_governance?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/ai_governance?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Your Render public URL, e.g. https://ai-governance-dashboard.onrender.com
NEXTAUTH_URL="https://your-app.onrender.com"
APP_URL="https://your-app.onrender.com"

# Password for seeded demo accounts (super@platform.com, admin@*, viewer@*)
SEED_PASSWORD="changeme"
